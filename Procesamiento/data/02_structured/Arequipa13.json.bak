        "id": "situaciones_adversas_hito_actual",
        "tipo": "A",
        "label": "Situaciones adversas identificadas en el hito de control",
        "valor": {
          "texto": "Se identificaron dos (2) situaciones adversas en la evaluación del hito de control 'Ejecución, supervisión y seguimiento de la capacitación de los actores electorales'",
          "estado": "Abierta"
        },
        "detalle": [
          {
            "texto": "Coordinadores de capacitación no vienen solicitando al coordinador distrital o al capacitador electoral, mediante correo electrónico o mensaje de WhatsApp, las fotografías o videos sobre las actividades de los miembros de mesa realizando la encuesta y el cuestionario, y debidamente desarrollados. Criterio vulnerado: Instructivo IN03-GOECOR/CAE versión 10, tarea 5.3.1 y POE versión 03 objetivo 4.2. Consecuencia: podría afectar el seguimiento y desarrollo de las actividades a realizar por los actores electorales el día de la jornada electoral.",
            "estado": "Abierta",
            "desde_momento": null,
